@{
    ViewData["Title"] = "Clientes";
}
<div>
    <h2>Clientes</h2>
    <p>Bienvenido a la página de clientes.</p>
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Código</th>
                    <th>Cédula</th>
                    <th>Apellidos</th>
                    <th>Nombres</th>
                    <th>Fecha de Nacimiento</th>
                    <th>Mail</th>
                    <th>Teléfono</th>
                    <th>Dirección</th>
                    <th>Estado</th>
					<th>Opciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var cliente in Model)
                {
                    <tr>
                        <td>@cliente.Codigo</td>
                        <td>@cliente.Cedula</td>
                        <td>@cliente.Apellidos</td>
                        <td>@cliente.Nombres</td>
                        <td>@cliente.FechaNacimiento.ToShortDateString()</td>
                        <td>@cliente.Mail</td>
                        <td>@cliente.Telefono</td>
                        <td>@cliente.Direccion</td>
                        <td>@cliente.Estado</td>
						<td>
							<a asp-action="Edit" asp-route-id="@cliente.Codigo"> <i class="bi bi-pencil-square"></i></a>
							<a asp-action="Details" asp-route-id="@cliente.Codigo"> <i class="bi bi-eye"></i></a>
							<a asp-action="Delete" asp-route-id="@cliente.Codigo"> <i class="bi bi-trash"></i></a>
						</td>
                    </tr>
                }
            </tbody>
        </table>
        <a class="btn btn-primary" role="button" asp-action="Create"> <i class="bi bi-plus-square"></i>Nuevo Cliente</a>
    </div>
</div>


